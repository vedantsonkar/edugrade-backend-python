# ── Runtime ──────────────────────────────────────────────────────────────────
ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://edugrade:edugrade@localhost:5432/edugrade
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ── Google OAuth (server-side flow) ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── AI grading ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GRADING_MODEL=gemini-2.5-flash-lite
OCR_PROVIDER=glm            # glm | off
GLM_OCR_API_KEY=
GLM_OCR_ENDPOINT=https://api.z.ai/api/paas/v4/layout_parsing

# ── Object storage (SeaweedFS S3 gateway) ────────────────────────────────────
SEAWEED_S3_ENDPOINT=http://localhost:8333
SEAWEED_S3_ACCESS_KEY_ID=admin
SEAWEED_S3_SECRET_ACCESS_KEY=seaweedfs
SEAWEED_S3_BUCKET=edugrade-files
SEAWEED_S3_REGION=us-east-1
SEAWEED_S3_PRESIGN_EXPIRE_SECONDS=3600

# ── Rate limiting ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── System webhooks ──────────────────────────────────────────────────────────
CRON_SECRET=change-me-cron-secret
